<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Filters the console instead of raising root's level, which stays at Logback's DEBUG default so tests that capture log events still receive them. MockMvc logs its servlet start at INFO. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>WARN</level>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} -- %msg%n</pattern>
        </encoder>
    </appender>

    <root level="DEBUG">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
