<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.peekaboot</groupId>
        <artifactId>peekaboot-parent</artifactId>
        <version>0.0.5-SNAPSHOT</version>
    </parent>

    <artifactId>peekaboot-spring-boot-starter</artifactId>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>Peekaboot Spring Boot Starter - Dependency aggregator for easy integration</description>

    <properties>
        <!-- No sources, yet Central requires a -sources jar for every jar component:
             make the source plugin build the (empty) archive anyway. -->
        <maven.source.forceCreation>true</maven.source.forceCreation>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.peekaboot</groupId>
            <artifactId>peekaboot-spring-boot-autoconfigure</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- No Java sources, so javadoc:jar produces nothing - and Central requires a
                 -javadoc jar for every jar component. Package the empty javadoc output
                 directory as that jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>empty-javadoc-jar</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>javadoc</classifier>
                            <classesDirectory>${project.build.directory}/apidocs</classesDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>