<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!-- The domain records and DTOs deliberately hold the List/Map instances they are
         given: they are JSON (de)serialization carriers for actuator payloads, not a
         mutable-state API. Defensive copies (List.copyOf/Map.copyOf) would throw on the
         null collections and null map values that real actuator data contains, so the
         exposure warnings are noise here. -->
    <Match>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
    </Match>

    <!-- The container markers and CPU facts the runtime detection reads - /.dockerenv,
         /run/.containerenv, /proc/1/cgroup and /proc/cpuinfo - are absolute by definition:
         they are where the container runtimes and the kernel put them, not paths the
         application chooses. The reading code takes them as parameters so tests can point
         it at temporary files. -->
    <Match>
        <Or>
            <Class name="org.peekaboot.backend.domain.runtime.ContainerRuntime$Signals"/>
            <Class name="org.peekaboot.backend.domain.runtime.MachineInfo"/>
        </Or>
        <Bug pattern="DMI_HARDCODED_ABSOLUTE_FILENAME"/>
    </Match>

</FindBugsFilter>
