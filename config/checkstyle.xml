<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!-- Metrics-only profile: complexity and size limits at the Checkstyle defaults.
     Formatting is owned by Spotless (palantir-java-format), bug patterns by
     Error Prone and SpotBugs - none of that is duplicated here. -->
<module name="Checker">
    <module name="TreeWalker">
        <module name="CyclomaticComplexity"/>
        <module name="NPathComplexity"/>
        <module name="BooleanExpressionComplexity"/>
        <module name="JavaNCSS"/>
        <module name="MethodLength"/>
        <!-- Methods only: constructor arity mirrors structure (DI wiring, record
             convenience constructors), not logic complexity. @Bean factory methods are
             that same DI wiring - the parameters are the injected collaborators - so
             they are exempt for the same reason. -->
        <module name="ParameterNumber">
            <property name="tokens" value="METHOD_DEF"/>
            <property name="ignoreAnnotatedBy" value="Bean"/>
        </module>
        <module name="ClassFanOutComplexity"/>
    </module>
    <!-- PeekabootAutoConfiguration's whole job is registering the dashboard's bean
         graph as explicit conditional @Bean methods, so it references that graph by
         design; its logic metrics (above) stay gated. -->
    <module name="SuppressionSingleFilter">
        <property name="files" value="PeekabootAutoConfiguration\.java"/>
        <property name="checks" value="ClassFanOutComplexity"/>
    </module>
</module>
