<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>

    <logger name="org.peekaboot" level="INFO"/>
    <!-- datasource-proxy logs every SQL statement here (at the level its
         datasource-proxy.query.log-level sets), which is what makes the demo's
         deliberate N+1 visible on the console as well as in the trace view -->
    <logger name="net.ttddyy.dsproxy.listener.logging.SLF4JQueryLoggingListener" level="TRACE"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
