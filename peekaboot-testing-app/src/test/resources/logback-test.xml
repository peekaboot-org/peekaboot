<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Boot's console appender plus filters hiding lines the tests provoke on purpose; Peekaboot's root appender still gets them. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="org.peekaboot.testsupport.IntentionalLogFilter">
            <logger>org.peekaboot.testingapp.controller.PersonController</logger>
            <message>An error occurred while trying to find all persons</message>
        </filter>
        <filter class="org.peekaboot.testsupport.IntentionalLogFilter">
            <logger>org.peekaboot.testingapp.Scheduler</logger>
            <message>fixedRate failed</message>
        </filter>
        <filter class="org.peekaboot.testsupport.IntentionalLogFilter">
            <logger>org.peekaboot.testingapp.controller.OrderController</logger>
            <message>order reconciliation gateway is unreachable</message>
        </filter>
        <filter class="org.peekaboot.testsupport.IntentionalLogFilter">
            <logger>org.peekaboot.testingapp.order.OrderReconciler</logger>
            <message>order PK-.* is still PLACED and has not been acknowledged</message>
        </filter>
        <!-- Banner: no LogCapture survives Boot's Logback reinit during context load. Challenge: AutoSecuredDashboardIT asserts it on a fresh app. -->
        <filter class="org.peekaboot.testsupport.IntentionalLogFilter">
            <logger>org.peekaboot.backend.security.SecurityPostureListener</logger>
            <message>(?s)\s*=+\s*:: Peekaboot Security ::.*</message>
        </filter>
        <filter class="org.peekaboot.testsupport.IntentionalLogFilter">
            <logger>org.peekaboot.backend.security.DashboardAuthenticationFilter</logger>
            <message>Challenged an unauthenticated request for /peekaboot/\S+ - nothing but Peekaboot's own generated credentials .*</message>
        </filter>
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>${CONSOLE_LOG_CHARSET}</charset>
        </encoder>
    </appender>

    <!-- OrderController's deliberately failing /boom endpoint (populating Peekaboot's Errors
         bucket in OrderTraceCaptureIT) escapes as an unhandled exception, which
         embedded Tomcat logs as a full stack trace. Spring Boot numbers each embedded Tomcat
         per JVM (Tomcat, Tomcat-1, ...), so an instance-specific logger name only matches an
         isolated run; Logback has no wildcard matching, and the numbered segment sits directly
         under ContainerBase, so that ancestor is the narrowest static name that works across
         runs. This silences ALL of ContainerBase's logging, not just per-request stack traces -
         also cluster, realm, child and threaded start/stop failures, and background-process
         errors, none of which any assertion here would catch. Accepted because this application
         configures no clustering and no custom realm, so those paths never fire, and because the
         application's own error logging is unaffected - a real application failure still prints
         and is still asserted. -->
    <logger name="org.apache.catalina.core.ContainerBase" level="OFF"/>

    <!-- Playwright teardown (PlaywrightTestBase.closePage's about:blank navigation and
         context close) aborts in-flight JSON responses, and Spring's resolver WARNs
         "Ignoring exception ... Broken pipe" for each aborted write - teardown noise, not
         application behaviour. Any failure this resolver really handles still reaches the
         client as a 4xx/5xx and fails the asserting test, so only that advisory WARN is
         lost by raising the level to ERROR. -->
    <logger name="org.springframework.web.servlet.mvc.support.DefaultHandlerExceptionResolver" level="ERROR"/>

    <!-- Reactor Netty warns on macOS that its native DNS resolver jar is absent; third-party, unused here. -->
    <logger name="io.netty.resolver.dns.DnsServerAddressStreamProviders" level="ERROR"/>

    <!-- Flyway warns that the H2 Boot manages is newer than the version it has verified; advisory only. -->
    <logger name="org.flywaydb.core.internal.database.base.Database" level="ERROR"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
