{
  "name": "peekaboot-frontend",
  "private": true,
  "description": "Lint toolchain for the embedded web UI. No build step: nothing here produces the jar's contents.",
  "scripts": {
    "lint:js": "eslint \"src/main/resources/META-INF/peekaboot/ui/**/*.js\"",
    "lint:css": "stylelint \"src/main/resources/META-INF/peekaboot/ui/**/*.css\"",
    "lint:html": "html-validate \"src/main/resources/META-INF/peekaboot/ui/**/*.html\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-import-x": "4.17.1",
    "globals": "17.12.0",
    "html-validate": "11.16.0",
    "stylelint": "17.15.0",
    "stylelint-config-recommended": "18.0.0",
    "stylelint-value-no-unknown-custom-properties": "6.1.1"
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
