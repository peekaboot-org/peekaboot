{
  "name": "peekaboot-frontend",
  "private": true,
  "type": "module",
  "description": "Lint and test toolchain for the embedded web UI. No build step: nothing here produces the jar's contents.",
  "scripts": {
    "lint:js": "eslint \"src/main/resources/META-INF/peekaboot/ui/**/*.js\" \"src/test/js/**/*.mjs\"",
    "lint:css": "stylelint \"src/main/resources/META-INF/peekaboot/ui/**/*.css\"",
    "lint:html": "html-validate \"src/main/resources/META-INF/peekaboot/ui/**/*.html\"",
    "test:js": "node --test \"src/test/js/**/*.test.mjs\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-import-x": "4.18.1",
    "globals": "17.14.0",
    "html-validate": "11.21.1",
    "stylelint": "18.1.0",
    "stylelint-config-recommended": "18.0.0",
    "stylelint-value-no-unknown-custom-properties": "6.1.1"
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
